// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  username  String?
  email     String   @unique
  emailVerified: Boolean
  image     String
  role      String @default(user)  
  banned    Boolean   
  posts     Post[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
